set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY football_scoreboard_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

set_global_assignment -name VERILOG_FILE football_scoreboard_top.v
set_global_assignment -name VERILOG_FILE scoring_mechanism_DFF.v
set_global_assignment -name VERILOG_FILE edge_detector.v
set_global_assignment -name VERILOG_FILE my_dff.v
set_global_assignment -name VERILOG_FILE timer_module.v
set_global_assignment -name VERILOG_FILE countdown_timer.v
set_global_assignment -name VERILOG_FILE hex_decoder.v

# DE1-SoC inputs retained from the original working course project.
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_W15 -to reset
set_location_assignment PIN_AE12 -to touchdown
set_location_assignment PIN_AD10 -to extra_point
set_location_assignment PIN_AC9 -to two_point_conversion
set_location_assignment PIN_AE11 -to field_goal
set_location_assignment PIN_AD12 -to safety
set_location_assignment PIN_Y16 -to manual_possession
set_location_assignment PIN_AB12 -to view_play_clock

# Possession indicators.
set_location_assignment PIN_V18 -to possession
set_location_assignment PIN_Y21 -to possession_other

# Team 1 tens digit (HEX5).
set_location_assignment PIN_V25 -to HEX5[0]
set_location_assignment PIN_AA28 -to HEX5[1]
set_location_assignment PIN_Y27 -to HEX5[2]
set_location_assignment PIN_AB27 -to HEX5[3]
set_location_assignment PIN_AB26 -to HEX5[4]
set_location_assignment PIN_AA26 -to HEX5[5]
set_location_assignment PIN_AA25 -to HEX5[6]

# Team 1 ones digit (HEX4).
set_location_assignment PIN_AA24 -to HEX4[0]
set_location_assignment PIN_Y23 -to HEX4[1]
set_location_assignment PIN_Y24 -to HEX4[2]
set_location_assignment PIN_W22 -to HEX4[3]
set_location_assignment PIN_W24 -to HEX4[4]
set_location_assignment PIN_V23 -to HEX4[5]
set_location_assignment PIN_W25 -to HEX4[6]

# Team 2 tens digit (HEX3).
set_location_assignment PIN_AJ29 -to HEX3[0]
set_location_assignment PIN_AH29 -to HEX3[1]
set_location_assignment PIN_AH30 -to HEX3[2]
set_location_assignment PIN_AG30 -to HEX3[3]
set_location_assignment PIN_AF29 -to HEX3[4]
set_location_assignment PIN_AF30 -to HEX3[5]
set_location_assignment PIN_AD27 -to HEX3[6]

# Team 2 ones digit (HEX2).
set_location_assignment PIN_AE26 -to HEX2[0]
set_location_assignment PIN_AE27 -to HEX2[1]
set_location_assignment PIN_AE28 -to HEX2[2]
set_location_assignment PIN_AG27 -to HEX2[3]
set_location_assignment PIN_AF28 -to HEX2[4]
set_location_assignment PIN_AG28 -to HEX2[5]
set_location_assignment PIN_AH28 -to HEX2[6]

# Game/play clock tens digit (HEX1).
set_location_assignment PIN_AD26 -to HEX1[0]
set_location_assignment PIN_AC27 -to HEX1[1]
set_location_assignment PIN_AD25 -to HEX1[2]
set_location_assignment PIN_AC25 -to HEX1[3]
set_location_assignment PIN_AB28 -to HEX1[4]
set_location_assignment PIN_AB25 -to HEX1[5]
set_location_assignment PIN_AB22 -to HEX1[6]

# Game/play clock ones digit (HEX0).
set_location_assignment PIN_AB23 -to HEX0[0]
set_location_assignment PIN_AE29 -to HEX0[1]
set_location_assignment PIN_AD29 -to HEX0[2]
set_location_assignment PIN_AC28 -to HEX0[3]
set_location_assignment PIN_AD30 -to HEX0[4]
set_location_assignment PIN_AC29 -to HEX0[5]
set_location_assignment PIN_AC30 -to HEX0[6]
